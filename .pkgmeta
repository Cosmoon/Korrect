package-as: Korrect
enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tools
  - tests
  - DEVELOPMENT.md
  - AGENTS.md
  - Data/DictionarySources
  - Data/Source
  - Data/ValidatedLanguages
  - Data/LanguageSources.json
  - __pycache__

# Optional dictionaries are LoadOnDemand addons stored as repository
# subfolders; the packager places them next to Korrect.
move-folders:
  Korrect/Korrect_enGB: Korrect_enGB
  Korrect/Korrect_deDE: Korrect_deDE
  Korrect/Korrect_frFR: Korrect_frFR
  Korrect/Korrect_esES: Korrect_esES
  Korrect/Korrect_itIT: Korrect_itIT
  Korrect/Korrect_nlNL: Korrect_nlNL
